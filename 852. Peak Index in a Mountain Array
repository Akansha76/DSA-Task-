class Solution {
    public int peakIndexInMountainArray(int[] arr) {
        int l=0;
        int r=arr.length-1;
        int a=0;
        while(l<=r){
            int m=l+(r-l)/2;
            if(arr[m]<arr[m+1]){
                a=m+1;
                l=m+1;
            }else if(arr[m]<arr[m-1]){
                a=m-1;
                r=m-1;
            }else{
                return m;
            }
        }
        return a;
    }
}
